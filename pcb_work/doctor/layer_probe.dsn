(pcb pcb_work/doctor/layer_probe.dsn
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (host_cad "KiCad's Pcbnew")
    (host_version "10.0.8-10.0.8~ubuntu24.04.1")
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu
      (type signal)
      (property
        (index 0)
      )
    )
    (layer B.Cu
      (type signal)
      (property
        (index 1)
      )
    )
    (boundary
      (path pcb 0  30000 -20000  0 -20000  0 0  30000 0  30000 -20000)
    )
    (via "Via[0-1]_600:300_um")
    (rule
      (width 200)
      (clearance 200)
      (clearance 50 (type smd_smd))
    )
  )
  (placement
    (component ""
      (place P2 25000 -10000 front 0)
      (place P1 5000 -10000 front 0)
      (place P3 15000 -5000 front 0)
    )
  )
  (library
    (image ""
      (pin Rect[T]Pad_1000.000000x1000.000000_um 1 0 0)
    )
    (padstack Rect[T]Pad_1000.000000x1000.000000_um
      (shape (rect F.Cu -500 -500 500 500))
      (attach off)
    )
    (padstack "Via[0-1]_600:300_um"
      (shape (circle F.Cu 600))
      (shape (circle B.Cu 600))
      (attach off)
    )
  )
  (network
    (net A
      (pins P2-1 P1-1)
    )
    (net B
      (pins P3-1)
    )
    (class kicad_default A B
      (circuit
        (use_via "Via[0-1]_600:300_um")
      )
      (rule
        (width 200)
        (clearance 200)
      )
    )
  )
  (wiring
    (wire (path F.Cu 500  20000 -500  20000 -19500)(net B)(type fix))
  )
)
