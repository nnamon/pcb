{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:pcb:render",
 "title": "pcb render output",
 "allOf": [
  {
   "$ref": "urn:pcb:envelope"
  }
 ],
 "properties": {
  "schema": {
   "const": "pcb/render/1"
  }
 },
 "if": {
  "properties": {
   "outcome": {
    "enum": [
     "done",
     "rejected"
    ]
   }
  }
 },
 "then": {
  "properties": {
   "data": {
    "type": "object",
    "properties": {
     "side": {
      "enum": [
       "top",
       "bottom"
      ],
      "description": "--look: the side rendered"
     },
     "finish": {
      "type": "object",
      "required": [
       "mask",
       "silk",
       "copper"
      ],
      "additionalProperties": false,
      "properties": {
       "mask": {
        "type": "string"
       },
       "silk": {
        "type": "string"
       },
       "copper": {
        "type": "string"
       }
      },
      "description": "--look: the finish rendered, pcb.toml [finish] or the default"
     },
     "order_options": {
      "type": "string",
      "description": "--look: the order form's options for that finish"
     }
    }
   }
  }
 }
}