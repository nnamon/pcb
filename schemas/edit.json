{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:pcb:edit",
 "title": "pcb edit output",
 "allOf": [
  {
   "$ref": "urn:pcb:envelope"
  }
 ],
 "properties": {
  "schema": {
   "const": "pcb/edit/1"
  }
 },
 "if": {
  "properties": {
   "outcome": {
    "enum": [
     "done",
     "rejected"
    ]
   }
  }
 },
 "then": {
  "required": [
   "written"
  ],
  "properties": {
   "data": {
    "type": "object",
    "required": [
     "ops",
     "fixed",
     "regressions",
     "drc_total_before",
     "drc_total_after",
     "written"
    ],
    "properties": {
     "ops": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "fixed": {
      "type": "array"
     },
     "regressions": {
      "type": "array"
     },
     "drc_total_before": {
      "type": "integer"
     },
     "drc_total_after": {
      "type": "integer"
     },
     "written": {
      "type": "string"
     }
    }
   }
  }
 }
}