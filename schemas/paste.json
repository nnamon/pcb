{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:pcb:paste",
 "title": "pcb paste output",
 "allOf": [
  {
   "$ref": "urn:pcb:envelope"
  }
 ],
 "properties": {
  "schema": {
   "const": "pcb/paste/1"
  }
 },
 "if": {
  "properties": {
   "outcome": {
    "enum": [
     "done",
     "rejected"
    ]
   }
  }
 },
 "then": {
  "properties": {
   "data": {
    "type": "object",
    "required": [
     "restored_footprints",
     "removed_apertures",
     "rules",
     "fixed",
     "regressions",
     "allowed",
     "drc_total_before",
     "drc_total_after",
     "written"
    ],
    "properties": {
     "fixed": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "regressions": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "allowed": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "drc_total_before": {
      "type": "integer"
     },
     "drc_total_after": {
      "type": "integer"
     },
     "written": {
      "type": "string"
     },
     "restored_footprints": {
      "type": "integer",
      "minimum": 0
     },
     "removed_apertures": {
      "type": "integer",
      "minimum": 0
     },
     "rules": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "pad",
        "pads",
        "apertures"
       ],
       "additionalProperties": false
      }
     }
    }
   }
  }
 }
}