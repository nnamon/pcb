{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:pcb:release",
 "title": "pcb release output",
 "allOf": [
  {
   "$ref": "urn:pcb:envelope"
  }
 ],
 "properties": {
  "schema": {
   "const": "pcb/release/1"
  }
 },
 "if": {
  "properties": {
   "outcome": {
    "enum": [
     "done",
     "rejected"
    ]
   }
  }
 },
 "then": {
  "properties": {
   "data": {
    "type": "object",
    "required": [
     "files",
     "gerber_layers",
     "bom_lines",
     "cpl_rows",
     "left_out",
     "written",
     "verify",
     "problems",
     "version_on_board",
     "bottom_parts"
    ],
    "properties": {
     "files": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "name",
        "sha256"
       ],
       "additionalProperties": false,
       "properties": {
        "name": {
         "type": "string"
        },
        "sha256": {
         "type": "string",
         "pattern": "^[0-9a-f]{64}$"
        }
       }
      }
     },
     "gerber_layers": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "bom_lines": {
      "type": "integer"
     },
     "cpl_rows": {
      "type": "integer"
     },
     "left_out": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "written": {
      "type": "string"
     },
     "problems": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "verify": {
      "type": "object",
      "required": [
       "layers",
       "islands",
       "plated_holes",
       "nets",
       "opens",
       "shorts",
       "unplaced_pads",
       "dfm"
      ]
     },
     "version_on_board": {
      "type": "boolean"
     },
     "bottom_parts": {
      "type": "integer",
      "minimum": 0
     }
    }
   }
  }
 }
}