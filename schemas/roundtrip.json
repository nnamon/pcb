{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:pcb:roundtrip",
 "title": "pcb roundtrip output",
 "allOf": [
  {
   "$ref": "urn:pcb:envelope"
  }
 ],
 "properties": {
  "schema": {
   "const": "pcb/roundtrip/1"
  }
 },
 "if": {
  "properties": {
   "outcome": {
    "enum": [
     "done",
     "rejected"
    ]
   }
  }
 },
 "then": {
  "properties": {
   "data": {
    "type": "object",
    "required": [
     "bytes",
     "identical"
    ],
    "properties": {
     "bytes": {
      "type": "integer",
      "minimum": 0
     },
     "identical": {
      "type": "boolean"
     }
    }
   }
  }
 }
}